# ai-therapist environment — copy to .env and fill in. Never commit .env.
# Every model, provider, and threshold here is env-swappable (docs/implementation.md §7.11).
# Values in # comments are examples only — nothing is a default.

# ---- LLM (via LiteLLM — model-agnostic, swap by changing the string) ----
# LiteLLM model names: https://docs.litellm.ai/docs/providers
MAIN_MODEL=            # main therapist model, e.g. gemini/gemini-2.5-flash
EXTRACTION_MODEL=      # small/fast state-extraction model, e.g. groq/gpt-oss-20b
SAFETY_MODEL=          # small zero-shot crisis classifier, e.g. groq/compound-mini

# Provider API keys (add the ones matching your model strings; LiteLLM routes by prefix)
GEMINI_API_KEY=        # https://aistudio.google.com/app/apikey
GROQ_API_KEY=          # https://console.groq.com/keys

# ---- Voice providers ----
SARVAM_API_KEY=        # https://dashboard.sarvam.ai — Saaras STT + Bulbul TTS
RUMIK_API_KEY=         # https://rumik.ai (Silk) — Mulberry/Muga TTS. Paused: no free tier; leave blank.
STT_PROVIDER=sarvam    # "sarvam" | "rumik" | ...  (eval-time swappable, never a default)
TTS_PROVIDER=sarvam    # "sarvam" | "rumik" | ...

# ---- Storage ----
# Postgres; matches the container started by `make setup`
DATABASE_URL=postgresql+asyncpg://aitherapy:aitherapy@localhost:5432/aitherapy
# Fernet key for app-layer encryption at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# ---- Session / course / timing ----
SESSION_MINUTES=45
COURSE_SESSIONS=8
# turn-end VAD threshold (seconds) per phase; Deepening > Landing (docs/implementation.md §7.7)
TURN_END_VAD_THRESHOLDS={"landing": 1.5, "opening": 2.0, "deepening": 3.5, "meaning": 2.5, "closing": 2.0}
SILENCE_CHECKIN_SECONDS=90

# ---- Crisis resources (surface on control page + speak in crisis protocol) ----
CRISIS_HELPLINE_NUMBER=14416    # India KIRAN / Tele-MANAS 14416
CRISIS_WEBSITE=                 # e.g. https://www.telemanas.gov.in
EMERGENCY_CONTACT_NUMBER=       # optional; crisis notification is no-op when unset (methodology §7.3)